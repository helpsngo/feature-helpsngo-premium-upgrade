# HELPS NGO Platform - Environment Variables Template
# Copy this file to .env and populate with production credentials.
# Do NOT commit actual secrets or private keys to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# AI Studio / Gemini Integration (Optional server-side AI features)
GEMINI_API_KEY=

# Payment Gateway Configuration (Optional - Required for Automated Online Card/Netbanking Checkout)
# If left blank, the platform cleanly falls back to verified Direct NPCI UPI QR and ICICI Bank NEFT/IMPS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WEBHOOK_SECRET=

# Notification & Dispatch Webhooks (WhatsApp Business & Email)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
